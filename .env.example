# Admin (required to use /admin). Use a long random password.
ADMIN_PASSWORD=
# Optional: separate key for signing the session cookie (defaults to a hash of ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# LLM agent: any OpenAI-compatible chat-completions endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional: SQLite file location (default .data/blog.sqlite). Needs a persistent disk.
DATABASE_PATH=
